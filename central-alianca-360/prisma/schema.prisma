generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  gestor
  consultor
  visualizador
}

enum StatusDivergencia {
  pendente
  confirmado
  rejeitado
  ignorado
}

enum TipoDivergencia {
  cliente_sem_vinculo
  venda_sem_consultor
  cliente_semelhante
  venda_duplicada
  visita_sem_venda
  venda_sem_montagem
  montagem_sem_cliente
  checklist_pendente
}

enum TipoVisita {
  consultor_externo
  checklist
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(visualizador)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  importacoes  Importacao[]
  divergencias Divergencia[] @relation("ConfirmadoPor")

  @@map("users")
}

model Consultor {
  id              String   @id @default(cuid())
  nome            String
  nomeNormalizado String   @map("nome_normalizado")
  email           String?
  telefone        String?
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  visitas    Visita[]
  vendas     Venda[]
  checklists Checklist[]
  comissoes  Comissao[]

  @@map("consultores")
}

model Cliente {
  id                  String   @id @default(cuid())
  nome                String
  nomeNormalizado     String   @map("nome_normalizado")
  telefone            String?
  cpfCnpj             String?  @map("cpf_cnpj")
  endereco            String?
  enderecoNormalizado String?  @map("endereco_normalizado")
  bairro              String?
  cidade              String?
  estado              String?
  origem              String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  visitas    Visita[]
  vendas     Venda[]
  montagens  Montagem[]
  checklists Checklist[]

  @@map("clientes")
}

model Visita {
  id                   String     @id @default(cuid())
  clienteId            String?    @map("cliente_id")
  consultorId          String?    @map("consultor_id")
  nomeClienteOriginal  String     @map("nome_cliente_original")
  telefoneOriginal     String?    @map("telefone_original")
  enderecoOriginal     String?    @map("endereco_original")
  tipoVisita           TipoVisita? @map("tipo_visita")
  dataVisita           DateTime   @map("data_visita")
  status               String?
  origem               String?
  origemId             String?    @map("origem_id")
  observacoes          String?
  contaParaConversao   Boolean    @default(false) @map("conta_para_conversao")
  contaParaPagamento   Boolean    @default(true) @map("conta_para_pagamento")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  cliente   Cliente?   @relation(fields: [clienteId], references: [id])
  consultor Consultor? @relation(fields: [consultorId], references: [id])

  @@map("visitas")
}

model Venda {
  id                  String   @id @default(cuid())
  clienteId           String?  @map("cliente_id")
  consultorId         String?  @map("consultor_id")
  numeroVenda         String?  @map("numero_venda")
  numeroOrcamento     String?  @map("numero_orcamento")
  nomeClienteOriginal String   @map("nome_cliente_original")
  vendedor            String?
  dataVenda           DateTime @map("data_venda")
  valorVendido        Decimal  @default(0) @map("valor_vendido") @db.Decimal(12, 2)
  valorRevertido      Decimal  @default(0) @map("valor_revertido") @db.Decimal(12, 2)
  status              String?
  statusTatico        String?  @map("status_tatico")
  origem              String?
  origemId            String?  @map("origem_id")
  cancelada           Boolean  @default(false)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  cliente   Cliente?   @relation(fields: [clienteId], references: [id])
  consultor Consultor? @relation(fields: [consultorId], references: [id])
  montagens Montagem[]

  @@map("vendas")
}

model Montagem {
  id                  String    @id @default(cuid())
  clienteId           String?   @map("cliente_id")
  vendaId             String?   @map("venda_id")
  numeroVenda         String?   @map("numero_venda")
  nomeClienteOriginal String    @map("nome_cliente_original")
  endereco            String?
  montador            String?
  dataAgendada        DateTime? @map("data_agendada")
  dataRealizada       DateTime? @map("data_realizada")
  status              String?
  atrasada            Boolean   @default(false)
  reagendada          Boolean   @default(false)
  problema            String?
  observacoes         String?
  origem              String?
  origemId            String?   @map("origem_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  cliente Cliente? @relation(fields: [clienteId], references: [id])
  venda   Venda?   @relation(fields: [vendaId], references: [id])

  @@map("montagens")
}

model Checklist {
  id                  String    @id @default(cuid())
  clienteId           String?   @map("cliente_id")
  consultorId         String?   @map("consultor_id")
  nomeClienteOriginal String    @map("nome_cliente_original")
  tipo                String?
  dataChecklist       DateTime  @map("data_checklist")
  status              String?
  pendente            Boolean   @default(false)
  observacoes         String?
  origem              String?
  origemId            String?   @map("origem_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  cliente   Cliente?   @relation(fields: [clienteId], references: [id])
  consultor Consultor? @relation(fields: [consultorId], references: [id])

  @@map("checklists")
}

model Divergencia {
  id                    String            @id @default(cuid())
  tipo                  TipoDivergencia
  entidadeOrigem        String?           @map("entidade_origem")
  entidadeDestino       String?           @map("entidade_destino")
  origemId              String?           @map("origem_id")
  destinoId             String?           @map("destino_id")
  descricao             String?
  percentualSimilaridade Float?           @map("percentual_similaridade")
  dadosOrigemJson       Json?             @map("dados_origem_json")
  dadosDestinoJson      Json?             @map("dados_destino_json")
  status                StatusDivergencia @default(pendente)
  confirmadoPorId       String?           @map("confirmado_por")
  confirmadoEm          DateTime?         @map("confirmado_em")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  confirmadoPor User? @relation("ConfirmadoPor", fields: [confirmadoPorId], references: [id])

  @@map("divergencias")
}

model Importacao {
  id                    String   @id @default(cuid())
  usuarioId             String   @map("usuario_id")
  tipo                  String
  origem                String?
  nomeArquivo           String   @map("nome_arquivo")
  caminhoArquivo        String   @map("caminho_arquivo")
  status                String   @default("pendente")
  totalRegistros        Int      @default(0) @map("total_registros")
  registrosProcessados  Int      @default(0) @map("registros_processados")
  registrosComErro      Int      @default(0) @map("registros_com_erro")
  registrosPendentes    Int      @default(0) @map("registros_pendentes")
  startedAt             DateTime? @map("started_at")
  finishedAt            DateTime? @map("finished_at")
  createdAt             DateTime @default(now()) @map("created_at")

  usuario User              @relation(fields: [usuarioId], references: [id])
  logs    ImportacaoLog[]

  @@map("importacoes")
}

model ImportacaoLog {
  id           String   @id @default(cuid())
  importacaoId String   @map("importacao_id")
  nivel        String
  mensagem     String
  dadosJson    Json?    @map("dados_json")
  createdAt    DateTime @default(now()) @map("created_at")

  importacao Importacao @relation(fields: [importacaoId], references: [id])

  @@map("importacao_logs")
}

model IntegrationJob {
  id                    String    @id @default(cuid())
  sistema               String
  tipo                  String
  status                String    @default("pendente")
  startedAt             DateTime? @map("started_at")
  finishedAt            DateTime? @map("finished_at")
  registrosImportados   Int       @default(0) @map("registros_importados")
  registrosComErro      Int       @default(0) @map("registros_com_erro")
  caminhoArquivoBaixado String?   @map("caminho_arquivo_baixado")
  mensagemErro          String?   @map("mensagem_erro")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  logs IntegrationJobLog[]

  @@map("integration_jobs")
}

model IntegrationJobLog {
  id             String   @id @default(cuid())
  jobId          String   @map("job_id")
  nivel          String
  mensagem       String
  dadosJson      Json?    @map("dados_json")
  screenshotPath String?  @map("screenshot_path")
  createdAt      DateTime @default(now()) @map("created_at")

  job IntegrationJob @relation(fields: [jobId], references: [id])

  @@map("integration_job_logs")
}

model SyncStatus {
  id                     String    @id @default(cuid())
  sistema                String
  tipo                   String
  ultimoStatus           String?   @map("ultimo_status")
  ultimaExecucao         DateTime? @map("ultima_execucao")
  ultimaExecucaoSucesso  DateTime? @map("ultima_execucao_sucesso")
  mensagem               String?
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@unique([sistema, tipo])
  @@map("sync_status")
}

model Comissao {
  id                         String   @id @default(cuid())
  consultorId                String   @map("consultor_id")
  mesReferencia              String   @map("mes_referencia")
  totalVisitasConsultorExterno Int    @default(0) @map("total_visitas_consultor_externo")
  totalVisitasChecklist      Int      @default(0) @map("total_visitas_checklist")
  totalVisitasPagaveis       Int      @default(0) @map("total_visitas_pagaveis")
  valorPorVisita             Decimal  @default(40) @map("valor_por_visita") @db.Decimal(10, 2)
  valorTotalVisitas          Decimal  @default(0) @map("valor_total_visitas") @db.Decimal(12, 2)
  valorVendido               Decimal  @default(0) @map("valor_vendido") @db.Decimal(12, 2)
  valorRevertido             Decimal  @default(0) @map("valor_revertido") @db.Decimal(12, 2)
  percentualComissao         Decimal  @default(1.5) @map("percentual_comissao") @db.Decimal(5, 2)
  valorComissao              Decimal  @default(0) @map("valor_comissao") @db.Decimal(12, 2)
  valorTotalEstimado         Decimal  @default(0) @map("valor_total_estimado") @db.Decimal(12, 2)
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  consultor Consultor @relation(fields: [consultorId], references: [id])

  @@unique([consultorId, mesReferencia])
  @@map("comissoes")
}
